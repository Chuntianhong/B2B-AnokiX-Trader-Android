<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="9dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/moveTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="GRV000005"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/moveSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Goods received · 25 Jun 2026"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="end"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/moveQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+2"
            android:textColor="@color/success"
            android:textSize="13sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/moveBal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="Bal 10"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
