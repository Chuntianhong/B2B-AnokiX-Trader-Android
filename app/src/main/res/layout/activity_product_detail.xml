<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/product_details"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/btnWishlist"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/wishlist"
            android:src="@drawable/ic_heart" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/purple_light"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:contentPadding="0dp"
                app:strokeColor="@color/divider"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/detailImage"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:contentDescription="@string/product_details"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:id="@+id/imageThumbsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/imageThumbs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/detailName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Product name"
                android:textColor="@color/text_primary"
                android:textSize="18sp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/detailBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="By Brand"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/detailPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="R0.00"
                android:textColor="@color/purple_primary"
                android:textSize="20sp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/incl_vat"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/in_stock"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/success" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/detailStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/in_stock"
                    android:textColor="@color/success"
                    android:textSize="12sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="14dp"
                    android:contentDescription="@string/next_day_delivery"
                    android:src="@drawable/ic_deliveries"
                    app:tint="@color/text_secondary" />

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/next_day_delivery"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/divider" />

            <!-- Info rows -->
            <include
                android:id="@+id/rowDistributor"
                layout="@layout/item_detail_info" />

            <include
                android:id="@+id/rowCategory"
                layout="@layout/item_detail_info" />

            <include
                android:id="@+id/rowSku"
                layout="@layout/item_detail_info" />

            <include
                android:id="@+id/rowBarcode"
                layout="@layout/item_detail_info" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/divider" />

            <!-- Quantity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_qty_stepper"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/detailMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/decrease"
                        android:padding="10dp"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/text_primary" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/detailQty"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/detailPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@string/increase"
                        android:padding="10dp"
                        android:src="@drawable/ic_add"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:id="@+id/detailStockCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="(in stock)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                style="@style/Widget.AnokiX.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/add_to_cart"
                android:textSize="14sp"
                app:icon="@drawable/ic_cart"
                app:iconGravity="textStart"
                app:iconTint="#FFFFFF" />

            <!-- Description -->
            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="@string/product_description"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/detailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text=""
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
