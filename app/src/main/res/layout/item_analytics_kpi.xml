<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <View
            android:id="@+id/kpiAccent"
            android:layout_width="34dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_inv_thumb" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/kpiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Sales Today"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/kpiValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="R18,450"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/kpiChange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+18% vs Yesterday"
            android:textColor="@color/success"
            android:textSize="10sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
