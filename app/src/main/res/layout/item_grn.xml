<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:contentPadding="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: expand toggle + GRN number + status badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/expandIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_add"
                app:tint="@color/purple_primary" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/grnNumber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GRN000004"
                android:textColor="@color/purple_primary"
                android:textSize="16sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/grnStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_success"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="Approved"
                android:textColor="@color/success"
                android:textSize="10sp" />
        </LinearLayout>

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/grnDistributor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sunrise Wholesale"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/grnMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="1 line(s) · 2 × Damaged stock"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Credit note (approved) -->
        <LinearLayout
            android:id="@+id/creditRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_grn_credit"
                app:tint="@color/success" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/grnCredit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CN000002 · R138.00"
                android:textColor="@color/success"
                android:textSize="12sp" />
        </LinearLayout>

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/grnDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="25 Jun 2026"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <!-- Expanded: line items + distributor note -->
        <LinearLayout
            android:id="@+id/expandContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
