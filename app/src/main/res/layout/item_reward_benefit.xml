<?xml version="1.0" encoding="utf-8"?>
<!-- One line in the "Your Benefits" card: icon, label, value. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/benefitIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/success_bg"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_wallet"
        app:tint="@color/success" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/benefitLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:text="@string/em_dash"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/benefitValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/em_dash"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />
</LinearLayout>
