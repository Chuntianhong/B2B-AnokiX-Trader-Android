<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/txnProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="Dynamic Monthly Voice" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/txnMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="082 123 4567 · 19:55" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="0dp">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/txnAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            tools:text="R 5 050,00" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/txnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_vas_pill"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Failed"
            tools:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
