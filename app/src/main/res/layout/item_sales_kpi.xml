<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/kpiIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_grv_icon_tile"
        android:backgroundTint="@color/purple_light"
        android:gravity="center"
        android:text="💰"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/kpiLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Total Sales"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/kpiValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="R0.00"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>
