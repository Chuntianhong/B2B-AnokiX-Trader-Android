<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/kpiIconContainer"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_kpi_icon_orange">

            <ImageView
                android:id="@+id/kpiIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_shopping_bag" />
        </FrameLayout>

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/kpiTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Pending Orders"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.anokix.trader.ui.views.RobotoBoldTextView
        android:id="@+id/kpiValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="126"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_kpi_value" />

    <LinearLayout
        android:id="@+id/kpiViewAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="2dp">

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/kpiActionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/view_all"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/text_primary" />

    </LinearLayout>
</LinearLayout>
