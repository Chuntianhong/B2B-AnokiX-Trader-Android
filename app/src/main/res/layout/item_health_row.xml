<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/healthLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Sales Growth"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/healthStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_success"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="Excellent"
        android:textColor="#FFFFFF"
        android:textSize="10sp" />
</LinearLayout>
