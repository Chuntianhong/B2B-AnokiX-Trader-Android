<?xml version="1.0" encoding="utf-8"?>
<!-- Airtime & VAS › Customers. Search + refresh over the end-customers onboarded with Limes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="16dp">

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vas_customers_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/vas_customers_body"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_login_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/text_secondary" />

        <com.anokix.traderapp.ui.views.RobotoEditText
            android:id="@+id/customerSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:gravity="center_vertical"
            android:hint="@string/vas_customers_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/customerCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="1 customer" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/customerSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_filter_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/vas_search"
            android:textColor="@color/purple_primary"
            android:textSize="12sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/customerRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_pill"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:text="@string/vas_refresh"
            android:textColor="@color/purple_primary"
            android:textSize="12sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/customerLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="20dp"
        android:indeterminateTint="@color/purple_primary"
        android:visibility="gone" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/customerEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="18dp"
        android:gravity="center"
        android:text="@string/vas_no_customers"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/customerList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="2"
        tools:listitem="@layout/item_vas_customer" />
</LinearLayout>
