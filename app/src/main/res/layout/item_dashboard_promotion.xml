<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_promo_slide"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/promoImage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_banner_placeholder"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/promoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="New Product Launch"
        android:textColor="#FFFFFF"
        android:textSize="15sp" />

    <!-- Absorbs the slack in the fixed-height page so the CTA is never clipped. -->
    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/promoDescription"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Introducing new food and beverage products."
        android:textColor="#C7D2FE"
        android:textSize="12sp" />

    <com.anokix.traderapp.ui.views.RobotoLightTextView
        android:id="@+id/promoValidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Valid until 30 Dec 2026"
        android:textColor="#94A3B8"
        android:textSize="11sp" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/promoCtaButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_white"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:text="@string/promo_shop_now"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />
</LinearLayout>
