<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_header_divider"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/spacing_sm"
            android:paddingVertical="@dimen/spacing_xs">

            <com.anokix.traderapp.ui.views.ResizableImageView
                android:layout_width="@dimen/logo_header_width"
                android:layout_height="wrap_content"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_anokix_logo_black" />
        </FrameLayout>

        <com.anokix.traderapp.ui.views.RobotoLightTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/login_subtitle"
            android:textAppearance="@style/TextAppearance.AnokiX.BrandSubtitle"
            android:textSize="@dimen/text_label" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="@dimen/header_icon_size"
        android:layout_height="@dimen/header_icon_size">

        <ImageButton
            android:id="@+id/notificationsButton"
            android:layout_width="@dimen/header_icon_size"
            android:layout_height="@dimen/header_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notifications"
            android:src="@drawable/ic_notifications"
            app:tint="@color/text_primary" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/notificationBadge"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_notification_badge"
            android:gravity="center"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_micro"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
