<?xml version="1.0" encoding="utf-8"?>
<!--
    POS Scan / QR sheet. Mirrors the portal's "Scan a barcode" modal, but the web
    version's "this browser can't decode from the camera" notice is replaced by a
    live camera scanner — a phone can decode, so it should. Manual entry stays for
    damaged labels and USB/Bluetooth handheld scanners (which type + press Enter).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/scanTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/scan_barcode_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/scanClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <!-- Camera scanner -->
            <FrameLayout
                android:id="@+id/scanCameraCard"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_scan_camera"
                android:clipToOutline="true">

                <androidx.camera.view.PreviewView
                    android:id="@+id/scanPreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Aiming frame -->
                <View
                    android:id="@+id/scanReticle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_margin="26dp"
                    android:background="@drawable/bg_scan_reticle"
                    android:visibility="gone" />

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:id="@+id/scanHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_scan_torch"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/scan_point_camera"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/scanTorch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/bg_scan_torch"
                    android:contentDescription="@string/scan_torch"
                    android:padding="8dp"
                    android:src="@drawable/ic_flash_off"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />

                <!-- Shown instead of the preview when the camera is unavailable or
                     permission has not been granted yet. -->
                <LinearLayout
                    android:id="@+id/scanCameraOff"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="24dp">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:id="@+id/scanCameraOffText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/scan_camera_permission_body"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanCameraOffAction"
                        style="@style/Widget.AnokiX.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:paddingHorizontal="18dp"
                        android:text="@string/scan_allow_camera"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Manual / handheld entry -->
            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/scan_manual_label"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/scanInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_bar"
                    android:hint="@string/scan_barcode_hint"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/scanAdd"
                    style="@style/Widget.AnokiX.Button.Primary"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="20dp"
                    android:text="@string/scan_add"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/scan_manual_help"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

            <!-- Result of the last scan / Add: added, out of stock, or not found -->
            <LinearLayout
                android:id="@+id/scanFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_scan_banner_success"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/scanFeedbackIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_check_circle"
                    app:tint="@color/success" />

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:id="@+id/scanFeedbackText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="18dp">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/scanCartSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/scanDone"
            style="@style/Widget.AnokiX.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:paddingHorizontal="28dp"
            android:text="@string/promo_done"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
