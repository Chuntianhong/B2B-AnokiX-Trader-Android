<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the horizontally scrolling "VAS Services" row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/vasIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/success_bg"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_phone"
        app:tint="@color/success" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/vasTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/em_dash"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/vasSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:minLines="2"
        android:text="@string/em_dash"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />
</LinearLayout>
