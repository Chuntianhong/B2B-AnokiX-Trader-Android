<?xml version="1.0" encoding="utf-8"?>
<!--
  POS "Sell Airtime & VAS" section, shown below the product grid. Mirrors the standalone
  Airtime & VAS screen but with POS wording ("Select amount", "Sell now"), the custom-amount
  input positioned directly under the product grid, and a "Buy for" (Myself / Someone else)
  summary panel that shows the sell price + estimated commission.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="20dp">

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="@string/pos_vas_section_title"
        android:textColor="@color/top_title"
        android:textSize="16sp" />

    <!-- 1. Choose a category -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_summary_card"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/vas_choose_category"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/vasCategoryToggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/vas_view_all"
                android:textColor="@color/success"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/vasCategoryLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"
            android:indeterminateTint="@color/purple_primary"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vasCategoryList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            tools:itemCount="4"
            tools:listitem="@layout/item_vas_category"
            tools:orientation="horizontal" />
    </LinearLayout>

    <!-- 2. Select a product -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_summary_card"
        android:orientation="vertical"
        android:padding="14dp">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vas_select_product"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/vasProductCategoryLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Limes CellC Recharges powered by Limes" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            style="@style/StoreFieldLabel"
            android:layout_marginTop="14dp"
            android:text="@string/vas_select_amount" />

        <ProgressBar
            android:id="@+id/vasProductLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginVertical="20dp"
            android:indeterminateTint="@color/purple_primary"
            android:visibility="gone" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/vasProductEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="18dp"
            android:gravity="center"
            android:text="@string/vas_no_products"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vasProductList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:nestedScrollingEnabled="false"
            tools:itemCount="4"
            tools:listitem="@layout/item_vas_product"
            tools:spanCount="2" />

        <!-- Custom amount (ad-hoc products only) — positioned directly under the grid. -->
        <LinearLayout
            android:id="@+id/vasCustomAmountBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                style="@style/StoreFieldLabel"
                android:text="@string/vas_custom_amount" />

            <com.anokix.traderapp.ui.views.RobotoEditText
                android:id="@+id/vasCustomAmountInput"
                style="@style/StoreFieldInput"
                android:hint="@string/vas_custom_amount_hint"
                android:inputType="numberDecimal" />
        </LinearLayout>

        <!-- Buy for + recipient + reference + totals summary panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_vas_sell_panel"
            android:orientation="vertical"
            android:padding="14dp">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                style="@style/StoreFieldLabel"
                android:layout_marginTop="0dp"
                android:text="@string/vas_buy_for" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/vasBuyMyself"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vas_toggle_selected"
                    android:gravity="center"
                    android:text="@string/vas_buy_myself"
                    android:textColor="@color/success"
                    android:textSize="12sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/vasBuySomeone"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_vas_toggle_unselected"
                    android:gravity="center"
                    android:text="@string/vas_buy_someone"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                style="@style/StoreFieldLabel"
                android:text="@string/vas_recipient_mobile" />

            <com.anokix.traderapp.ui.views.RobotoEditText
                android:id="@+id/vasRecipientInput"
                style="@style/StoreFieldInput"
                android:drawableStart="@drawable/ic_person"
                android:drawablePadding="8dp"
                android:hint="@string/vas_recipient_mobile_hint"
                android:inputType="phone" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                style="@style/StoreFieldLabel"
                android:text="@string/vas_optional_reference" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <com.anokix.traderapp.ui.views.RobotoEditText
                    android:id="@+id/vasReferenceInput"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="@drawable/bg_login_input"
                    android:gravity="center_vertical"
                    android:hint="@string/vas_reference_hint"
                    android:inputType="text"
                    android:maxLength="30"
                    android:paddingStart="12dp"
                    android:paddingEnd="46dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="12sp" />

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:id="@+id/vasReferenceCounter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="12dp"
                    android:text="@string/vas_ref_counter_zero"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/success_border" />

            <!-- Sell price + estimated commission -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_sell_price"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/vasSellPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        tools:text="R 0,00" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:orientation="vertical">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vas_commission_est"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.anokix.traderapp.ui.views.RobotoBoldTextView
                        android:id="@+id/vasCommission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/success"
                        android:textSize="16sp"
                        tools:text="R 0,00" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/vasSellButton"
                style="@style/Widget.AnokiX.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/vas_sell_now" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/vas_wallet_note"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
