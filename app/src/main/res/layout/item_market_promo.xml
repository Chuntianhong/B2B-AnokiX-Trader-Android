<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <View
            android:id="@+id/promoAccent"
            android:layout_width="4dp"
            android:layout_height="46dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_inv_thumb" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/promoBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunlight Range"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/promoDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="On all Sunlight washing products"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/promoExpires"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Valid till 31 Dec 2024"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />
        </LinearLayout>

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/promoOffer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_success"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="10% OFF"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
