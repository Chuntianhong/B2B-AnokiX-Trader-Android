<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Distributor + amount/status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/avatarText"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_inv_thumb"
                android:gravity="center"
                android:text="GF"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.trader.ui.views.RobotoBoldTextView
                    android:id="@+id/traderName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Global Foods"
                    android:textColor="@color/purple_primary"
                    android:textSize="15sp" />

                <com.anokix.trader.ui.views.RobotoBoldTextView
                    android:id="@+id/orderId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="ORD000005"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />

                <com.anokix.trader.ui.views.RobotoTextView
                    android:id="@+id/orderTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="24 Jun 2026, 21:13"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <com.anokix.trader.ui.views.RobotoBoldTextView
                    android:id="@+id/orderAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R80.00"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <com.anokix.trader.ui.views.RobotoBoldTextView
                    android:id="@+id/statusRibbon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_badge_warning"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="PENDING"
                    android:textColor="@color/warning"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Products -->
        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/productsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.05"
            android:text="PRODUCTS 1"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/productChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:chipSpacingVertical="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <!-- Delivery info + action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/deliveryInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Est. delivery 26 Jun 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewDetail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/view_detail"
                android:textColor="@color/purple_primary"
                android:textSize="12sp"
                app:icon="@drawable/ic_eye"
                app:iconSize="16dp"
                app:iconTint="@color/purple_primary"
                app:strokeColor="@color/purple_primary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
