<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Distributor + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/avatarText"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_inv_thumb"
                android:gravity="center"
                android:text="TB"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.anokix.trader.ui.views.RobotoBoldTextView
                    android:id="@+id/traderName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tiger Brands"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.anokix.trader.ui.views.RobotoTextView
                    android:id="@+id/orderLocation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tiger Brands Distribution"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/statusRibbon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_warning"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="PENDING"
                android:textColor="@color/warning"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Order id + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/orderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ORD-10548"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/orderTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="13 Jun 2026, 09:15"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Items + amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/productSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12 items"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/orderAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R 1,216.00"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/divider" />

        <!-- Delivery info + action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.trader.ui.views.RobotoTextView
                android:id="@+id/deliveryInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Est. delivery 15 Jun 2026"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/orderAction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="View Details →"
                android:textColor="@color/purple_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
