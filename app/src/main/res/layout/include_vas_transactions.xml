<?xml version="1.0" encoding="utf-8"?>
<!-- Airtime & VAS › Recent transactions. Same feed as before, now on its own tab. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="16dp">

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vas_recent_transactions"
        android:textColor="@color/text_primary"
        android:textSize="16sp" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/txnEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="18dp"
        android:gravity="center"
        android:text="@string/vas_no_transactions"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/txnList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_vas_transaction" />
</LinearLayout>
