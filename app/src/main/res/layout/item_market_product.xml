<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Image area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp">

            <View
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_inv_thumb" />

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/productImageInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="C"
                android:textColor="#FFFFFF"
                android:textSize="28sp" />

            <com.anokix.trader.ui.views.RobotoBoldTextView
                android:id="@+id/productBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_badge_purple"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="Popular"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />
        </FrameLayout>

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/productName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Coca-Cola 2L"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/productPack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Case (6 x 2L)"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/productPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="R129"
            android:textColor="@color/purple_primary"
            android:textSize="16sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/productStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="In Stock • 120+ cases"
            android:textColor="@color/success"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/productAdd"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Add"
            android:textSize="12sp"
            app:cornerRadius="9dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
