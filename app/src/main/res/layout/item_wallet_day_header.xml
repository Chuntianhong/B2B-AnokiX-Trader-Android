<?xml version="1.0" encoding="utf-8"?>
<!--
  Date separator inside the wallet's transaction list ("Today", "Yesterday", "07 Aug
  2026"). The API returns a flat list, so the grouping is derived from each row's date —
  it is what turns ten timestamps into something a shopkeeper can read at a glance.
-->
<com.anokix.traderapp.ui.views.RobotoBoldTextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="12dp"
    android:paddingBottom="4dp"
    android:textAllCaps="true"
    android:textColor="@color/text_tertiary"
    android:letterSpacing="0.06"
    android:textSize="11sp" />
