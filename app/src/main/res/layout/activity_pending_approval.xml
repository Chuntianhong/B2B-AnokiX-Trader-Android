<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Back to login -->
        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/pendingBackLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingVertical="8dp"
            android:paddingEnd="8dp"
            android:text="@string/pending_back_link"
            android:textColor="#8A93B2"
            android:textSize="14sp"
            android:drawablePadding="6dp" />

        <!-- Clock badge -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pending_glow">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pending_circle">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_clock"
                    app:tint="@android:color/white" />
            </FrameLayout>
        </FrameLayout>

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/pending_title"
            android:textColor="@android:color/white"
            android:textSize="20sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/pendingSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/pending_subtitle_generic"
            android:justificationMode="inter_word"
            android:textColor="#8A93B2"
            android:textSize="14sp" />

        <!-- Details card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_pending_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="6dp">

            <!-- Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pending_status_label"
                    android:textColor="#8A93B2"
                    android:textSize="13sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/statusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pending_badge_purple"
                    android:gravity="center"
                    android:layout_marginStart="12dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/pending_status_value"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A4A" />

            <!-- Business -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_business_label"
                    android:textColor="#8A93B2"
                    android:textSize="13sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/businessValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="textEnd"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="Sunrise Wholesale (Pty) Ltd" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A4A" />

            <!-- Reference -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_reference_label"
                    android:textColor="#8A93B2"
                    android:textSize="13sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/referenceValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:letterSpacing="0.03"
                    android:textAlignment="textEnd"
                    android:textColor="#6EA8FE"
                    android:textSize="14sp"
                    tools:text="DIST000007" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A4A" />

            <!-- Submitted -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pending_submitted_label"
                    android:textColor="#8A93B2"
                    android:textSize="13sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/submittedValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textAlignment="textEnd"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    tools:text="19/06/2026 20:43:01" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1C2A4A" />

            <!-- IMB Wallet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="14dp">

                <com.anokix.traderapp.ui.views.RobotoTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pending_wallet_label"
                    android:textColor="#8A93B2"
                    android:textSize="13sp" />

                <com.anokix.traderapp.ui.views.RobotoBoldTextView
                    android:id="@+id/walletBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_badge_muted"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="@string/pending_wallet_not_activated"
                    android:textColor="#B4C3D8"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Wallet info box -->
        <LinearLayout
            android:id="@+id/infoBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pending_info"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="14dp"
            android:paddingVertical="14dp">

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:id="@+id/infoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:text="@string/pending_wallet_later"
                android:textColor="#A9B4CC"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- What happens next -->
        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/pending_next_title"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/nextStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Back to login button -->
        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/btnBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_btn_continue"
            android:gravity="center"
            android:text="@string/back_to_login"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <!-- Support footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_email"
                app:tint="#8A93B2" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pending_need_help"
                android:textColor="#8A93B2"
                android:textSize="13sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/supportEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackground"
                android:text="@string/pending_support_email"
                android:textColor="#6EA8FE"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
