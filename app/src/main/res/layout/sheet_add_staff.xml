<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/staff_add_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/sheetClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cancel_btn"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- First / last name, side by side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        style="@style/StaffRequiredMarker"
                        android:text="@string/support_required_marker" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        style="@style/StaffFieldLabel"
                        android:text="@string/staff_first_name" />
                </LinearLayout>

                <EditText
                    android:id="@+id/inputFirstName"
                    style="@style/StaffFieldInput"
                    android:hint="@string/staff_first_name_hint"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        style="@style/StaffRequiredMarker"
                        android:text="@string/support_required_marker" />

                    <com.anokix.traderapp.ui.views.RobotoTextView
                        style="@style/StaffFieldLabel"
                        android:text="@string/staff_last_name" />
                </LinearLayout>

                <EditText
                    android:id="@+id/inputLastName"
                    style="@style/StaffFieldInput"
                    android:hint="@string/staff_last_name_hint"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>
        </LinearLayout>

        <!-- Email -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoTextView
                style="@style/StaffRequiredMarker"
                android:text="@string/support_required_marker" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                style="@style/StaffFieldLabel"
                android:text="@string/staff_email" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputEmail"
            style="@style/StaffFieldInput"
            android:hint="@string/staff_email_hint"
            android:inputType="textEmailAddress" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/staff_email_helper"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />

        <!-- Password -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoTextView
                style="@style/StaffRequiredMarker"
                android:text="@string/support_required_marker" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                style="@style/StaffFieldLabel"
                android:text="@string/staff_password_label" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_filter_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="@string/staff_password_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingVertical="0dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/togglePassword"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/staff_show_password"
                android:padding="7dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Job title (optional) -->
        <com.anokix.traderapp.ui.views.RobotoTextView
            style="@style/StaffFieldLabel"
            android:layout_marginTop="16dp"
            android:text="@string/staff_job_title" />

        <EditText
            android:id="@+id/inputJobTitle"
            style="@style/StaffFieldInput"
            android:hint="@string/staff_job_title_hint"
            android:inputType="textCapWords" />

        <!-- Mobile number (optional) -->
        <com.anokix.traderapp.ui.views.RobotoTextView
            style="@style/StaffFieldLabel"
            android:layout_marginTop="16dp"
            android:text="@string/staff_mobile" />

        <EditText
            android:id="@+id/inputPhone"
            style="@style/StaffFieldInput"
            android:hint="@string/staff_mobile_hint"
            android:inputType="phone" />

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="20dp"
                android:text="@string/cancel_btn"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmit"
                style="@style/Widget.AnokiX.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/staff_add_submit" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
