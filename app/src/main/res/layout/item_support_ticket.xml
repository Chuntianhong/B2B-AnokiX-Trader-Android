<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/ticketTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Wallet settlement delay"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/ticketStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_warning"
            android:paddingHorizontal="9dp"
            android:paddingVertical="2dp"
            android:text="Open"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />
    </LinearLayout>

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/ticketDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Settlement to IMB account has not reflected after 24 hours."
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/ticketMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="#14523 · Updated 13 Jun 2026, 09:30"
        android:textColor="@color/text_tertiary"
        android:textSize="10sp" />
</LinearLayout>
