<?xml version="1.0" encoding="utf-8"?>
<!-- One entry in the points ledger (api/common/rewards/overview → activity[]). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="11dp">

    <!-- Pale tile, saturated glyph — both tints are set in code from the entry type. -->
    <ImageView
        android:id="@+id/pointsIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/success_bg"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_promo_gift"
        app:tint="@color/success" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/pointsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/em_dash"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/pointsDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/em_dash"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/pointsDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/em_dash"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp" />
    </LinearLayout>

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/pointsValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/em_dash"
        android:textColor="@color/success"
        android:textSize="14sp" />
</LinearLayout>
