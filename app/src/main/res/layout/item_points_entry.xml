<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="11dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_inv_thumb">

        <ImageView
            android:id="@+id/pointsIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_promo_gift"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/pointsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Earned"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/pointsDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Purchase at anokiX POS · Today, 10:32"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <com.anokix.trader.ui.views.RobotoBoldTextView
        android:id="@+id/pointsValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="+450"
        android:textColor="@color/success"
        android:textSize="14sp" />
</LinearLayout>
