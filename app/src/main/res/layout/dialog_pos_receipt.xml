<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sale_recorded"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/receiptClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </LinearLayout>

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/receiptSaleNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="SALE000000"
        android:textColor="@color/purple_primary"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/receiptItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <LinearLayout
        android:id="@+id/receiptTotals"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/receiptDone"
        style="@style/Widget.AnokiX.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="end"
        android:layout_marginTop="18dp"
        android:paddingHorizontal="28dp"
        android:text="@string/promo_done" />
</LinearLayout>
