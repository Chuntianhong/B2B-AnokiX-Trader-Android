<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:background="@drawable/bg_summary_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/featureIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_star"
        app:tint="@color/purple_primary"
        android:contentDescription="@string/marketplace" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/featureTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Best Prices"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/featureSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="From trusted suppliers"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
