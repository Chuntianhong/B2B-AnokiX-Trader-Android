<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/card_machine_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/cardMachineDismiss"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Amount being pushed to the machine -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_info_box"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/card_machine_amount"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/cardMachineAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R0.00"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />
    </LinearLayout>

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/card_machine_label"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Which machine to send to -->
    <LinearLayout
        android:id="@+id/cardMachineSelector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/cardMachineValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/cardMachineChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/card_machine_choose"
            android:src="@drawable/ic_chevron_down"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Result line: the gateway's own wording on failure, confirmation on success -->
    <LinearLayout
        android:id="@+id/cardMachineStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/cardMachineStatusIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="1dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert_circle" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/cardMachineStatusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/danger"
            android:textSize="13sp" />
    </LinearLayout>

    <!--
        Actions are stacked full-width rather than sat side by side: the Send label
        carries the amount, so a wrap_content row overflows and clips the button on a
        narrow screen, a large system font, or simply a bigger sale. Full width also
        gives the one action that moves money the tap target it deserves.
    -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/cardMachineSend"
        style="@style/Widget.AnokiX.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:maxLines="1"
        app:icon="@drawable/ic_credit_card"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconSize="18dp"
        app:iconTint="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cardMachineClose"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:maxLines="1"
        android:text="@string/close"
        android:textColor="@color/text_secondary"
        app:cornerRadius="10dp"
        app:strokeColor="@color/border" />
</LinearLayout>
