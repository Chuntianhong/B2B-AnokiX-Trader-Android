<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <View
            android:id="@+id/statusAccent"
            android:layout_width="34dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_inv_thumb" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/statusTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Store Status"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/statusValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Active"
            android:textColor="@color/success"
            android:textSize="18sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/statusSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Everything is running smoothly."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
