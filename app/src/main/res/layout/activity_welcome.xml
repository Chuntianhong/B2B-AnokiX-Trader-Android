<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/login_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <ImageView
            android:layout_width="220dp"
            android:layout_height="150dp"
            android:layout_marginTop="80dp"
            android:contentDescription="@null"
            android:src="@drawable/welcome_storefront" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/welcome_title"
            android:textColor="@android:color/white"
            android:textSize="28sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="@string/welcome_tagline"
            android:textColor="#8A93B2"
            android:textSize="15sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/loginButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_welcome_login_gradient"
            android:gravity="center"
            android:text="@string/welcome_login"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/createAccountButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_welcome_create_account"
            android:gravity="center"
            android:text="@string/welcome_create_account"
            android:textColor="@color/success"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_have_account"
                android:textColor="#8A93B2"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:id="@+id/signInButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="@string/welcome_sign_in"
                android:textColor="#5B8DEF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/supportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_headset"
                app:tint="#8A93B2" />

            <com.anokix.traderapp.ui.views.RobotoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_need_help"
                android:textColor="#8A93B2"
                android:textSize="14sp" />

            <com.anokix.traderapp.ui.views.RobotoBoldTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/padding1"
                android:text="@string/welcome_support_centre"
                android:textColor="#5B8DEF"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
