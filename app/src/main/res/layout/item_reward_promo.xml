<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the "Promotions & Offers" row. Copy and tone come from the API. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.anokix.traderapp.ui.views.RobotoBoldTextView
            android:id="@+id/promoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/em_dash"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <com.anokix.traderapp.ui.views.RobotoTextView
            android:id="@+id/promoBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:minLines="2"
            android:text="@string/em_dash"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/promoIcon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/success_bg"
        android:contentDescription="@null"
        android:padding="11dp"
        android:src="@drawable/ic_promo_gift"
        app:tint="@color/success" />
</LinearLayout>
