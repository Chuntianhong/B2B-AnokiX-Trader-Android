<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <com.anokix.trader.ui.views.RobotoBoldTextView
        android:id="@+id/fastRank"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_rank_circle"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/purple_primary"
        android:textSize="12sp" />

    <com.anokix.trader.ui.views.RobotoTextView
        android:id="@+id/fastName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Classic White Bread 700g"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <com.anokix.trader.ui.views.RobotoBoldTextView
        android:id="@+id/fastUnits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="24 sold"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />
</LinearLayout>
