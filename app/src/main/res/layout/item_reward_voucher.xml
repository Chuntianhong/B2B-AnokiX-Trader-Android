<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/voucherBrand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_inv_thumb"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="MTN"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <com.anokix.trader.ui.views.RobotoBoldTextView
            android:id="@+id/voucherTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="R10 Airtime Voucher"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <com.anokix.trader.ui.views.RobotoTextView
            android:id="@+id/voucherPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="1,000 pts"
            android:textColor="@color/purple_primary"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voucherRedeem"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Redeem"
            android:textSize="11sp"
            app:cornerRadius="9dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
