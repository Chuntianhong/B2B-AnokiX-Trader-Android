<?xml version="1.0" encoding="utf-8"?>
<!--
  One card in the "Redeem with Limes" row. The brand tile carries the brand's own colour
  from the API; the Redeem button goes flat and grey when the trader cannot afford it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="14dp">

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/voucherInitial"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="@color/purple_primary"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/voucherBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/em_dash"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <com.anokix.traderapp.ui.views.RobotoTextView
        android:id="@+id/voucherTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:minLines="2"
        android:text="@string/em_dash"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <com.anokix.traderapp.ui.views.RobotoBoldTextView
        android:id="@+id/voucherPoints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/em_dash"
        android:textColor="@color/success"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/voucherRedeem"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:paddingHorizontal="0dp"
        android:text="@string/rewards_redeem"
        android:textColor="@color/success"
        android:textSize="12sp"
        app:cornerRadius="10dp"
        app:strokeColor="@color/success" />
</LinearLayout>
